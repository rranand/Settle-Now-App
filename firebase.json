{
    "hosting": {
        "public": "build/web",
        "headers": [
            {
                "source": "**/*.@(js|css|html)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000"
                    },
                    {
                        "key": "Content-Encoding",
                        "value": "gzip"
                    }
                ]
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "appAssociation": "AUTO",
        "rewrites": [
            {
                "source": "/invite/**",
                "dynamicLinks": true
            },
            {
                "source": "/privacy-policy",
                "destination": "/privacy-policy.html"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}